{
  "extends": "default",
  "meta": { "name": "backend-serve", "description": "uvicorn app, dev_db.py, dev_seed.py: no writes, egress via proxy to allow_domain only" },
  "groups": { "include": ["python_runtime"] },
  "workdir": { "access": "read" },
  "filesystem": {
    "deny": ["$WORKDIR/**/.env", "$WORKDIR/test.env"]
  },
  "network": {
    "allow_domain": ["placeholder.invalid", "hbci.olb.de", "fints.deutsche-bank.de", "brokerage-hbci.consorsbank.de", "giristation.local.muc.mkleinhans.de", "llamacpp.muc.mkleinhans.de", "mxf914.netcup.net:993"],
    "open_port": [5432],
    "listen_port": [8000]
  },
  "environment": { "set_vars": { "PYTHONDONTWRITEBYTECODE": "1" } }
}
