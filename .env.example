# --- Database ---
# Database host; default: localhost
# POSTGRES_HOST=localhost
# Database port, 1 to 65535; default: 5432
# POSTGRES_PORT=5432
# Database name; required
POSTGRES_DB=
# Database user; required
POSTGRES_USER=
# Database password; required; alternatively POSTGRES_PASSWORD_FILE (path to a file holding it), not both
POSTGRES_PASSWORD=

# --- Ledger ---
# Base currency, a three-letter upper-case ISO code, fixed after the first start; required
BASE_CURRENCY=
# Days an exchange rate may be old, at least 0; default: 7
# MAX_RATE_AGE_DAYS=7
# Days of tolerance when matching transactions, at least 0; default: 7
# MATCHING_WINDOW_DAYS=7
# Days of tolerance when matching documents, at least 0; default: 7
# DOCUMENT_WINDOW_DAYS=7

# --- Household ---
# IANA time zone name; required
TIMEZONE=
# Display locale; default: en
# LOCALE=en

# --- Users ---
# Groups are numbered contiguously from 1 without gaps; logins must be unique; none at all is allowed
# Login of user 1
USER_1_LOGIN=
# Display name of user 1
USER_1_NAME=
# Password of user 1, optional only when OIDC_ENFORCED=true; alternatively USER_1_PASSWORD_FILE, not both
USER_1_PASSWORD=
# USER_2_LOGIN=
# USER_2_NAME=
# USER_2_PASSWORD=

# --- OIDC ---
# Provider address (http or https, no credentials, query or fragment); OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET: all three or none
# OIDC_ISSUER=
# Client id registered with the provider; all three or none
# OIDC_CLIENT_ID=
# Client secret; all three or none; alternatively OIDC_CLIENT_SECRET_FILE, not both
# OIDC_CLIENT_SECRET=
# The app's external address, no path; required with OIDC; the redirect address is <BASE_URL>/api/session/oidc/callback
# BASE_URL=
# Space-separated scopes, must include openid; default: openid email profile
# OIDC_SCOPES=openid email profile
# Claim used as the login, compared without regard to case; default: email
# OIDC_LOGIN_ATTRIBUTE=email
# Claim used as the display name, wins over USER_<n>_NAME; default: name
# OIDC_DISPLAYNAME_ATTRIBUTE=name
# Only members of this group may sign in via OIDC (add groups to OIDC_SCOPES); optional
# OIDC_ALLOWED_GROUP=
# true or false; true requires OIDC and turns password sign-in off; default: false
# OIDC_ENFORCED=false

# --- Model ---
# Model endpoint address; MODEL_ENDPOINT and MODEL_NAME: both or neither, absent means the AI classifier does not run
# MODEL_ENDPOINT=
# Model name; both or neither
# MODEL_NAME=
# API key for the model endpoint, optional; alternatively MODEL_API_KEY_FILE, not both
# MODEL_API_KEY=
# optional reasoning effort (low, medium or high, anything else fails the start), sent as the request's reasoning effort for a model that reasons, and not sent when unset
# MODEL_REASONING_EFFORT=low
# --- Bank access ---
# FinTS product registration id, optional; without it a FinTS login stops before the PIN prompt
# FINTS_PRODUCT_ID=

# --- Development ---
# true or false; registers the deterministic test importers; leave off in a deployment; default: false
# ENABLE_TEST_IMPORTERS=false
# true or false; serves /api/openapi.json without a session; leave off in a deployment; default: false
# EXPOSE_OPENAPI=false