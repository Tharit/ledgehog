# Environment of the stack in compose.example.yaml (spec/architecture.md §5.7).
# Portainer: paste into the stack's "Environment variables" (advanced mode), or save as `.env`
# next to the compose file. The secret values at the bottom are passed to the app as
# environment variables, like the rest.
# The repo's .env.example is the DEVELOPMENT example: a deployment differs (POSTGRES_HOST is
# fixed to the relay in the compose file).

# --- Database (the role and database of README.md, "Database") ---
POSTGRES_DB=ledgehog
POSTGRES_USER=ledgehog

# --- Ledger and household ---
# required, three-letter code, fixed for the life of the ledger
BASE_CURRENCY=
# required, IANA zone, e.g. Europe/Berlin
TIMEZONE=
LOCALE=en
# at least 0
MAX_RATE_AGE_DAYS=7
# at least 0
MATCHING_WINDOW_DAYS=7

# --- Users (numbered from 1 without gaps; the compose file has two, add groups there too) ---
USER_1_LOGIN=
USER_1_NAME=
USER_2_LOGIN=
USER_2_NAME=

# --- Optional groups: uncomment here AND in the compose file ---
# the external https address, no path; required with OIDC
# BASE_URL=https://ledger.example.org
# OIDC_ISSUER, OIDC_CLIENT_ID and the secret: all three or none
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_ALLOWED_GROUP=
# MODEL_ENDPOINT and MODEL_NAME: both or neither
# MODEL_ENDPOINT=
# MODEL_NAME=
# both or neither
# VISION_MODEL_ENDPOINT=
# VISION_MODEL_NAME=
# FINTS_PRODUCT_ID=

# --- Never set in a deployment: ENABLE_TEST_IMPORTERS, EXPOSE_OPENAPI, HTTPS_PROXY, NO_PROXY ---

# --- Secrets (values only; passed to the app as environment variables). Required: ---
POSTGRES_PASSWORD=
USER_1_PASSWORD=
USER_2_PASSWORD=
# --- Secrets, with their optional group (uncomment the matching lines in the compose file) ---
# OIDC_CLIENT_SECRET=
# MODEL_API_KEY=
# VISION_MODEL_API_KEY=
